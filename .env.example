# Oqlo Code — Bring Your Own Key (BYOK) configuration.
# Copy to `.env` and fill in the providers you actually use. Any provider whose
# key is absent is automatically skipped in the fallback chain.

# --- OpenRouter (single key, many models) ---------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini / Vertex ----------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Routing policy -------------------------------------------------------
# Provider priority is, by default: 1.antigravity 2.cursor 3.codex 4.api
# One of: local_first | max_intelligence | cost_optimization
OQLO_ROUTING_POLICY=local_first

# Terminal-only mode: never launch GUI apps (1 = on, default). Keep this on.
OQLO_TERMINAL_ONLY=1

# Activate local executives (they otherwise defer to the next tier).
# Set to 1 only if you have a real local agent wired in.
OQLO_ANTIGRAVITY_ACTIVE=0
OQLO_CURSOR_ACTIVE=0
OQLO_CODEX_ACTIVE=0

# Bridge endpoints (override only if you changed the in-app listeners).
OQLO_BLENDER_WS_URL=ws://127.0.0.1:9876
OQLO_UNITY_REST_URL=http://127.0.0.1:8088
OQLO_CURSOR_WORKSPACE=
